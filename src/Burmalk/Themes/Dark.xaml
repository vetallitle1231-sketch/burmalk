<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<SolidColorBrush x:Key="BgDark" Color="#080F20"/>
<SolidColorBrush x:Key="PanelBg" Color="#101D35"/>
<SolidColorBrush x:Key="FgMain" Color="#EDF3FF"/>
<SolidColorBrush x:Key="FgMuted" Color="#9CB3D5"/>
<SolidColorBrush x:Key="Accent" Color="#0065EF"/>
<Style TargetType="Window"><Setter Property="Foreground" Value="{DynamicResource FgMain}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
<Style TargetType="UserControl"><Setter Property="Foreground" Value="{DynamicResource FgMain}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource FgMain}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style x:Key="Title" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource FgMain}"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
<Style x:Key="BigValue" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource FgMain}"/><Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,3,0,6"/></Style>
<Style x:Key="SubValue" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource FgMuted}"/><Setter Property="Margin" Value="0,3,0,3"/></Style>
<Style x:Key="Panel" TargetType="Border"><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource PanelRadius}"/><Setter Property="Opacity" Value="{DynamicResource PanelOpacity}"/><Setter Property="Padding" Value="{DynamicResource PanelPadding}"/><Setter Property="Margin" Value="0,0,10,12"/></Style>
<Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource FgMain}"/><Setter Property="Background" Value="{DynamicResource ControlBg}"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource FgMain}"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
<Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource FgMain}"/><Setter Property="Background" Value="{DynamicResource ControlBg}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,8,8"/><Setter Property="CaretBrush" Value="White"/></Style>
<Style TargetType="ComboBox"><Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#14233B"/></DataTemplate></Setter.Value></Setter><Setter Property="Margin" Value="0,4,8,8"/><Setter Property="Padding" Value="8"/></Style>
<Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="Foreground" Value="{DynamicResource FgMain}"/><Setter Property="RowBackground" Value="{DynamicResource PanelBg}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource RowAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderColor}"/><Setter Property="RowHeight" Value="36"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource ControlBg}"/><Setter Property="Foreground" Value="{DynamicResource FgMuted}"/><Setter Property="Padding" Value="8"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource FgMain}"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style x:Key="NavItem" TargetType="ListBoxItem"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></DataTemplate></Setter.Value></Setter>
<Setter Property="Foreground" Value="{DynamicResource FgMuted}"/><Setter Property="Padding" Value="14,10"/><Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="4,2"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource ControlBg}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style TargetType="DataGridCell"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="8,0"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>






