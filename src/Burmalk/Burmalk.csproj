<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Burmalk</RootNamespace>
    <AssemblyName>Burmalk</AssemblyName>
    <Product>Burmalk</Product>
    <Title>Burmalk</Title>
    <Description>Burmalk PC monitoring dashboard</Description>
    <ApplicationIcon>Assets/Burmalk.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.4</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <Resource Include="Assets/Burmalk.png" />
    <Resource Include="Assets/Burmalk.ico" />
    <Resource Include="Assets/Anime.png" />
    <Content Include="../../docs/THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="PresentMonFps" Version="2.0.6" />
  </ItemGroup>

</Project>
